# =========================================================
# [필수 — 운영(Railway)] 아래 값이 없으면 운영 모드(NODE_ENV=production)에서
# 서버가 부팅 시 즉시 종료됩니다 (fail-closed).
# =========================================================

# 운영 모드로 실행합니다. Railway 등 운영 환경에서는 반드시 production.
NODE_ENV=production

# JWT 서명 비밀키 (32자 이상 무작위 문자열).
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 운영 중 회전(변경) 금지 — 회전 시 기존 토큰이 모두 무효화되어 전원 로그아웃됩니다.
JWT_SECRET=CHANGE_THIS_TO_A_32PLUS_CHAR_RANDOM_SECRET

# 학교 관리자 비밀번호 (8자 이상)
ADMIN_PASSWORD=CHANGE_THIS_TO_ADMIN_PASSWORD

# Postgres 연결 문자열. Railway에서는 Postgres 플러그인을 추가하면 자동 주입됩니다.
DATABASE_URL=postgres://user:password@host:5432/dbname

# 금융위원회 주식시세정보 일별 OHLCV 공공데이터 인증키
# 공공데이터포털에서 발급받은 일반 인증키(Decoding)를 권장합니다.
# 실제 키는 이 파일에 적거나 Git/ZIP에 넣지 말고 Railway Variables에만 설정합니다.
PUBLIC_DATA_SERVICE_KEY=여기에_공공데이터_서비스키
# 서버는 이 키로 새 일별 자료를 한국시간 14:10에 하루 1회 확인합니다.
# 공식 자료는 기준일 다음 영업일 오후 1시 이후 반영될 수 있으며 시간봉/실시간 자료가 아닙니다.

# =========================================================
# [선택]
# =========================================================

# 서버 포트 (Railway는 자체적으로 PORT를 주입하므로 보통 지정할 필요 없음)
PORT=3000

# 학생 시작 자금
INITIAL_CASH=1000000

# 교육용 거래 수수료율 (0.001 = 0.1%). 관리자 화면에서 0~1% 범위로 변경 가능
TRADE_FEE_RATE=0.001

# 학교 공통 초기 교사 비밀번호(8자 이상). 설정 시 모든 교사 계정에 항상 유효(개인 비밀번호와 병행).
# TEACHER_MASTER_PASSWORD=

# 뉴스: 키 없이 공개 뉴스가 기본. 네이버 키가 있으면 선택적으로 우선 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_SOURCE=AUTO
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search
GDELT_CONTEXT_API_URL=https://api.gdeltproject.org/api/v2/context/context
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_CACHE_MS=600000
NEWS_DISPLAY=5
